# Runtime configuration. Keep real .env profiles and credentials out of Git.
# Stable identity shared with backend routing; do not change to retry an operation.
STORAGE_CONTROLLER_AGENT_ID=storage-controller-1
RMQ_URL=amqps://connector:REPLACE_ME@rabbitmq.example.test:5671/
# Legacy BROKER_URL is accepted only when RMQ_URL is absent or identical.
AMQP_QUEUE_TYPE=classic
# Default queue: agent.<STORAGE_CONTROLLER_AGENT_ID>.tasks; migrate old queues explicitly.
# TASK_QUEUE=agent.storage-controller-1.tasks
JOBS_EXCHANGE=jobs
RESULTS_EXCHANGE=results
TELEMETRY_EXCHANGE=agent.telemetry
TELEMETRY_ROUTING_KEY=inventory.storage.full

# Durable shared journal: MongoDB replica set, persistent database, no TTL.
MONGO_URL=mongodb://connector:REPLACE_ME@mongo.example.test:27017/openhvx-ceph?replicaSet=rs0&authSource=admin

# Ceph Dashboard API and configured iSCSI gateway.
CEPH_API_URL=https://ceph.example.test:8443
CEPH_API_USER=openhvx-connector
CEPH_API_PASSWORD=REPLACE_ME
CEPH_DEFAULT_POOL=rbd
CEPH_INSECURE_TLS=false
CEPH_API_ACCEPT=application/vnd.ceph.api.v1.0+json
CEPH_GW_ISCSI_HOST=ceph-gw-01
CEPH_GW_ISCSI_IP=192.0.2.10
# Optional CHAP credentials; both values must be provided together.
# CEPH_TARGET_USER=openhvx
# CEPH_TARGET_PASSWORD=REPLACE_ME

# Positive integers in milliseconds. HTTP port serves /healthz and /readyz only.
PORT=3000
INVENTORY_INTERVAL_MS=300000
HEARTBEAT_INTERVAL_MS=60000
CREATE_READINESS_TIMEOUT_MS=180000
LOG_ENABLED=1
LOG_LEVEL=info
LOG_JSON=1
LOG_SERVICE_NAME=ceph-connector

# Tests only: dedicated disposable RabbitMQ, matching RMQ_URL.
# AMQP_INTEGRATION_URL=amqp://integration:integration-only-password@127.0.0.1:5672/
