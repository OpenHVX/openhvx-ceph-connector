{
  "name": "openhvx-storage-controller",
  "version": "0.1.0",
  "private": true,
  "description": "Storage controller that talks to the OpenHVX broker (AMQP) and interfaces with Ceph.",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpileOnly src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "lint": "tsc --noEmit",
    "test": "node --test -r ts-node/register src/tests/*.test.ts"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "axios": "^1.6.7",
    "dotenv": "^16.4.5",
    "mongodb": "^6.22.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/node": "^22.20.5",
    "mongodb-memory-server": "^11.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
